# Locenti environment template. Copy to .env.local and fill in per environment.
# M1 (current) needs NONE of these: the demo runs entirely on fixture data.
# Never commit real values. Server-only secrets must not use the NEXT_PUBLIC_ prefix.

# Public site URL used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- M2: sign in with Google (free; Google Cloud Console → OAuth client) ---
# Without these and DATABASE_URL, /sign-in and /app show a "not configured"
# state. Setup guide: docs/GOOGLE_CLOUD_SETUP.md
GOOGLE_OAUTH_CLIENT_ID=             # ends in .apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=         # server only, mark Sensitive in Vercel
SESSION_SECRET=                     # server only, random, at least 32 characters

# --- M2: email + password sign-in (optional; free with a Gmail App Password) ---
# Sends verification and password-reset emails. Without it, Google sign-in still works
# and the email form explains that email sign-up isn't available yet.
SMTP_URL=                           # e.g. smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
EMAIL_FROM=                         # optional; defaults to the SMTP username
# Without SMTP_URL, account emails (sign-up confirmation, password reset, invites) go out from your Gmail
# connected in Locenti: this address if set, else a connected mailbox in a workspace owned by someone in ADMIN_EMAILS.
SYSTEM_EMAIL_FROM=

# --- M2: database (free Neon Postgres via Vercel → Storage; sets this automatically) ---
# Local development: any Postgres 15+ with database/migrations applied.
DATABASE_URL=
DB_POOL_MAX=                        # optional, connections per server instance (default 3)

# Private-beta allowlist, checked on every sign-in: comma-separated emails and/or @domains.
# Empty = nobody can sign in. Example: owner@gmail.com,@partner-agency.com
BETA_ALLOWED_EMAILS=
SIGNUP_OPEN=                          # true: anyone can sign up and start a free trial; unset = only BETA_ALLOWED_EMAILS and invited people

# --- M2: business discovery (OpenStreetMap, free, no key) ---
OSM_CONTACT_EMAIL=                  # contact address sent to OpenStreetMap's public services (their usage policy asks for one)
# NOMINATIM_URL= / OVERPASS_URL=    # optional: self-hosted or commercial instances (OVERPASS_URL may list several, comma-separated; default tries 3 public ones)

# --- M2: Google Maps search (Places API (New), server-side key) ---
GOOGLE_PLACES_API_KEY=              # key restricted to "Places API (New)"; never exposed to the browser
GOOGLE_PLACES_DAILY_LIMIT=            # optional Locenti-side daily cap; unset = no cap (Google's quota applies)
DISCOVERY_MONTHLY_LIMIT=              # businesses per workspace per month on trial/free plans; unset = 200, "off" = no limit

# --- Public owner details for the legal pages and footer (needed for Google's app verification) ---
# NEXT_PUBLIC_CONTACT_EMAIL=        # default hello@locenti.com
# NEXT_PUBLIC_LEGAL_NAME=           # default Burhan Javed (founder)
# NEXT_PUBLIC_BUSINESS_ADDRESS=     # optional postal address
# NEXT_PUBLIC_LEGAL_COUNTRY=        # optional, e.g. Pakistan
GOOGLE_SITE_VERIFICATION=           # Search Console "HTML tag" content value (proves you own the site)

# --- M2: Gmail sending (uses the Google OAuth client above; send-only permission asked on "Connect Gmail") ---
# GMAIL_OAUTH_CLIENT_ID= / GMAIL_OAUTH_CLIENT_SECRET=   # optional: a separate OAuth client just for Gmail; default reuses the sign-in client
# TOKEN_ENCRYPTION_KEY=             # optional: 32 random bytes, base64 (openssl rand -base64 32). Default: derived from SESSION_SECRET

# --- M2: verification provider (chosen after a terms review) ---
VERIFICATION_PROVIDER=
VERIFICATION_API_KEY=               # server only

# --- M2: built-in AI writer (Google Gemini; free key at aistudio.google.com) ---
GEMINI_API_KEY=                     # server only
# GEMINI_MODEL=gemini-2.5-flash     # optional override
# People can also connect their own AI agent over MCP (Agent page); that needs no server key.

# --- M2: campaign sending scheduler ---
CRON_SECRET=                        # long random string; the scheduler calls /api/cron/dispatch with "Authorization: Bearer <CRON_SECRET>"

# --- M2: durable jobs (e.g. Trigger.dev) ---
TRIGGER_SECRET_KEY=                 # server only

# --- M3: billing (provider to be confirmed by the owner) ---
BILLING_PROVIDER=
STRIPE_SECRET_KEY=                  # server only
STRIPE_WEBHOOK_SECRET=              # server only

# Admin panel (/admin): exact emails of platform owners, comma-separated. Empty means nobody.
ADMIN_EMAILS=
ADMIN_TIMEZONE=                       # admin panel times and per-day charts; unset = Asia/Karachi (Pakistan Standard Time)
# Trial length shown in the admin panel (days). Not enforced until billing exists.
TRIAL_DAYS=14

# Billing (Paddle). Leave empty until you set up Paddle; the app keeps working without it.
# Client-side token from Paddle → Developer tools → Authentication (starts with test_ in sandbox, live_ in production).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox or production
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Monthly price ids (pri_…) from Paddle → Catalog, one per plan in config/plans.ts.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_AGENCY=
# Secret of the notification destination pointing at https://<your domain>/api/billing/paddle
PADDLE_WEBHOOK_SECRET=
# true = ended trials and lapsed plans can't search, research, write with AI or send. Off until you launch billing.
BILLING_ENFORCE=false
