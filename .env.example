# Locentio environment template. Copy to .env.local and fill in per environment.
# M1 (current) needs NONE of these: the demo runs entirely on fixture data.
# Never commit real values. Server-only secrets must not use the NEXT_PUBLIC_ prefix.

# Public site URL used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- M2: sign in with Google (free; Google Cloud Console → OAuth client) ---
# Without these and DATABASE_URL, /sign-in and /app show a "not configured"
# state. Setup guide: docs/GOOGLE_CLOUD_SETUP.md
GOOGLE_OAUTH_CLIENT_ID=             # ends in .apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=         # server only, mark Sensitive in Vercel
SESSION_SECRET=                     # server only, random, at least 32 characters

# --- M2: database (free Neon Postgres via Vercel → Storage; sets this automatically) ---
# Local development: any Postgres 15+ with database/migrations applied.
DATABASE_URL=

# Private-beta allowlist, checked on every sign-in: comma-separated emails and/or @domains.
# Empty = nobody can sign in. Example: owner@gmail.com,@partner-agency.com
BETA_ALLOWED_EMAILS=

# --- M2: providers (one of each, chosen after a terms review) ---
DISCOVERY_PROVIDER=
DISCOVERY_API_KEY=                  # server only
VERIFICATION_PROVIDER=
VERIFICATION_API_KEY=               # server only

# --- M2: AI (Anthropic, server-side adapter; model is configurable) ---
ANTHROPIC_API_KEY=                  # server only
ANTHROPIC_MODEL=

# --- M2 step 5: Gmail sending (reuses the Google OAuth client above) ---
TOKEN_ENCRYPTION_KEY=               # server only, 32-byte key for mailbox tokens

# --- M2: durable jobs (e.g. Trigger.dev) ---
TRIGGER_SECRET_KEY=                 # server only

# --- M3: billing (provider to be confirmed by the owner) ---
BILLING_PROVIDER=
STRIPE_SECRET_KEY=                  # server only
STRIPE_WEBHOOK_SECRET=              # server only
