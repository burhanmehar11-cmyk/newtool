# Locentio environment template. Copy to .env.local and fill in per environment.
# M1 (current) needs NONE of these: the demo runs entirely on fixture data.
# Never commit real values. Server-only secrets must not use the NEXT_PUBLIC_ prefix.

# Public site URL used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- M2: accounts (Firebase Authentication) ---
# Public web config from Firebase → Project settings → Your apps (not secrets).
# Without these and the database settings, /sign-in, /sign-up and /app show a
# "not configured" state. See docs/GOOGLE_CLOUD_SETUP.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account JSON (raw or base64). Used by Firebase Admin and the Cloud SQL
# connector. Needs the "Cloud SQL Client" role. Server only. Mark Sensitive in Vercel.
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- M2: database (Cloud SQL for PostgreSQL) ---
CLOUD_SQL_INSTANCE=                 # PROJECT_ID:REGION:INSTANCE
DB_USER=postgres
DB_PASSWORD=                        # server only
DB_NAME=locentio
# Local development alternative to Cloud SQL (any Postgres 15+ with the migrations applied):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/locentio

# Private-beta sign-up allowlist: comma-separated emails and/or @domains.
# Empty = sign-up closed. Example: owner@agency.com,@partner-agency.com
BETA_ALLOWED_EMAILS=

# --- M2: providers (one of each, chosen after a terms review) ---
DISCOVERY_PROVIDER=
DISCOVERY_API_KEY=                  # server only
VERIFICATION_PROVIDER=
VERIFICATION_API_KEY=               # server only

# --- M2: AI (Anthropic, server-side adapter; model is configurable) ---
ANTHROPIC_API_KEY=                  # server only
ANTHROPIC_MODEL=

# --- M2: Gmail sending ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=         # server only
TOKEN_ENCRYPTION_KEY=               # server only, 32-byte key for mailbox tokens

# --- M2: durable jobs (e.g. Trigger.dev) ---
TRIGGER_SECRET_KEY=                 # server only

# --- M3: billing (provider to be confirmed by the owner) ---
BILLING_PROVIDER=
STRIPE_SECRET_KEY=                  # server only
STRIPE_WEBHOOK_SECRET=              # server only
